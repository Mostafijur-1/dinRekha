# Public canonical application URL used for metadata and absolute links.
# Local: http://localhost:3000
# Preview/Production: set to the canonical deployment URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB (server-only)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=chondo

# Authentication (generate a cryptographically random value with at least 32 characters)
AUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional locally, required to show Continue with Google)
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Optional separate HMAC secret; AUTH_SECRET is used when omitted
RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Password reset email delivery through the Resend HTTP API
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Chondo <no-reply@example.com>
